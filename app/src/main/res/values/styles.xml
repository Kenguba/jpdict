<resources>
    <style name="Theme.JpQuickLookup" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#EAF7FF</item>
        <item name="android:colorAccent">#0AA3FF</item>
        <item name="android:statusBarColor">#EAF7FF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.JpQuickLookup.Popup" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">#0AA3FF</item>
    </style>
    <style name="Theme.LookupLinkBridge" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#0AA3FF</item>
    </style>

    <style name="Theme.Jpdict.Page" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#F2F2F2</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#F2F2F2</item>
        <item name="android:navigationBarColor">#F2F2F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#008FD1</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Jpdict.Dialog</item>
    </style>
    <style name="Theme.Jpdict.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_rounded</item>
        <item name="android:colorAccent">#006BFF</item>
    </style>
    <style name="Theme.Jpdict.Page.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#171E2B</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#171E2B</item>
        <item name="android:navigationBarColor">#171E2B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#75ADFF</item>
        <item name="android:textColorPrimary">#EDF2FA</item>
        <item name="android:textColorSecondary">#ACB9CD</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Jpdict.Dialog.Dark</item>
    </style>
    <style name="Theme.Jpdict.Dialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#252E3D</item>
        <item name="android:colorBackground">#252E3D</item>
        <item name="android:colorAccent">#75ADFF</item>
        <item name="android:textColorPrimary">#EDF2FA</item>
        <item name="android:textColorSecondary">#ACB9CD</item>
        <item name="android:timePickerStyle">@style/Widget.Jpdict.TimePicker</item>
    </style>
    <style name="Widget.Jpdict.TimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">#303C4E</item>
        <item name="android:numbersBackgroundColor">#303C4E</item>
    </style>
    <style name="Theme.JpQuickLookup.Popup.Dark" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">#75ADFF</item>
    </style>
</resources>
